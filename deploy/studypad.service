# systemd unit for the StudyPad self-host server.
#   sudo cp deploy/studypad.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now studypad
[Unit]
Description=StudyPad (static site + cloud sync)
After=network.target

[Service]
Type=simple
User=anindyadc
WorkingDirectory=/home/anindyadc/deploy/studypad
# STUDYPAD_SYNC_TOKEN (and optional PORT, STUDYPAD_DATA_DIR) live in ./.env
ExecStart=/home/anindyadc/.bun/bin/bun server/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
